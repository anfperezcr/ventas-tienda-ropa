# Pooler de Supabase (Supavisor) en modo TRANSACCIÓN (puerto 6543).
# Usuario = "<rol>.<project-ref>", no solo "<rol>" -- ver CLAUDE.md §12 y
# Project Settings > Database > Connection string en el dashboard.
# Las passwords se setean a mano en el SQL Editor (alter role ... with
# password ...), nunca se escriben en un archivo del repo.
DATABASE_URL_TENANT="postgres://app_tenant.<project-ref>:<password>@<pooler-host>:6543/postgres"
DATABASE_URL_PLATFORM="postgres://app_platform.<project-ref>:<password>@<pooler-host>:6543/postgres"

# Secreto para firmar el JWT de sesión (jose). Cualquier string largo y
# aleatorio, por ejemplo: openssl rand -base64 32
SESSION_SECRET=""

# Solo los usa scripts/seed-tenant.ts, para crear un tenant de prueba
# rápido en dev (el panel de super_admin, Fase 2, ya lo hace desde la UI).
SEED_TENANT_SLUG=""
SEED_TENANT_NOMBRE=""
SEED_OWNER_NOMBRE=""
SEED_OWNER_USUARIO=""
SEED_OWNER_PASSWORD=""

# Solo lo usa scripts/seed-super-admin.ts -- bootstrap del primer usuario
# super_admin (no hay auto-registro, ver CLAUDE.md §8).
SEED_SUPERADMIN_NOMBRE=""
SEED_SUPERADMIN_USUARIO=""
SEED_SUPERADMIN_PASSWORD=""
